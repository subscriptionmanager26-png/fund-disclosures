# Copy to .env — never commit real values.

# Push to kushagra-agarwal-a/fund-holdings-data (required for holdings:sync* --push)
HOLDINGS_GH_TOKEN=

# Edelweiss AMC API (required for fetch)
EDELWEISS_API_SECRET=

# Optional; falls back to HOLDINGS_GH_TOKEN
GH_TOKEN=

# Navi MF — Cloudflare Browser Rendering (required on cloud VMs; see docs/NAVI_PORTFOLIO_AUTOMATION.md)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
