# Copy to .env — never commit real values.

# Push to kushagra-agarwal-a/fund-holdings-data (required for holdings:sync* --push)
HOLDINGS_GH_TOKEN=

# Edelweiss AMC API (required for fetch)
EDELWEISS_API_SECRET=

# Optional; falls back to HOLDINGS_GH_TOKEN
GH_TOKEN=

# Navi MF — Cloudflare Browser Rendering (required on cloud VMs; see docs/NAVI_PORTFOLIO_AUTOMATION.md)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Union MF — Webshare proxy (required on cloud VMs; see docs/UNION_MF_WEBSHARE_PROXY.md)
UNION_WEBSHARE_PROXY_USER=
UNION_WEBSHARE_PROXY_PASSWORD=
# UNION_WEBSHARE_PROXY_URL=http://user:pass@31.59.20.176:6754
# UNION_WEBSHARE_PROXY_HOSTS=31.59.20.176:6754,45.38.107.97:6014
